{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical execution artifact envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request", "result"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "request": {
      "anyOf": [
        {"type": "object"},
        {"type": "null"}
      ]
    },
    "result": {"type": "object"}
  }
}
