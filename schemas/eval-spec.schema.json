{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/eval-spec.schema.json",
  "title": "Agent Company Canonical Eval Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "spec_id",
    "execution_id",
    "job_id",
    "evaluator_id",
    "evaluator_version",
    "checks",
    "metadata"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "spec_id": {"$ref": "#/$defs/id"},
    "execution_id": {"$ref": "#/$defs/id"},
    "job_id": {"$ref": "#/$defs/id"},
    "evaluator_id": {"$ref": "#/$defs/id"},
    "evaluator_version": {"type": "string", "minLength": 1, "maxLength": 50},
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/check"}
    },
    "metadata": {"$ref": "#/$defs/metadata"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "evaluator_type", "severity", "config"],
      "properties": {
        "check_id": {"$ref": "#/$defs/id"},
        "evaluator_type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "major", "minor"]
        },
        "config": {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {"$ref": "#/$defs/config_value"}
        }
      }
    },
    "config_value": {
      "oneOf": [
        {"type": "string", "maxLength": 2000},
        {"type": "number", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
        {"type": "boolean"},
        {"type": "null"},
        {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/config_value"}
        },
        {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {"$ref": "#/$defs/config_value"}
        }
      ]
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {"$ref": "#/$defs/scalar"}
    },
    "scalar": {
      "oneOf": [
        {"type": "string", "maxLength": 2000},
        {"type": "number", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
        {"type": "boolean"},
        {"type": "null"}
      ]
    }
  }
}
