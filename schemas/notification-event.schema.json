{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/notification-event.schema.json",
  "title": "NotificationEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notification_id",
    "notification_type",
    "created_at",
    "target_human_identity",
    "source_type",
    "source_id",
    "severity",
    "title",
    "summary",
    "approval_id",
    "authorization_fingerprint",
    "metadata"
  ],
  "properties": {
    "notification_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "notification_type": {
      "enum": ["APPROVAL_REQUESTED", "APPROVAL_APPROVED", "APPROVAL_REJECTED", "JOB_COMPLETED", "JOB_FAILED", "RUNTIME_ERROR"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "target_human_identity": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_type": {"type": "string", "minLength": 1, "maxLength": 100},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "severity": {"enum": ["info", "warning", "error"]},
    "title": {"type": "string", "maxLength": 200},
    "summary": {"type": "string", "maxLength": 1200},
    "approval_id": {"type": ["string", "null"], "maxLength": 200},
    "authorization_fingerprint": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {"type": "object"}
  }
}
