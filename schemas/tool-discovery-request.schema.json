{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/tool-discovery-request.schema.json",
  "title": "Canonical Tool Discovery Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "required_capabilities",
    "agent",
    "workflow",
    "execution_mode",
    "max_risk_level",
    "allowed_authority_classes",
    "allowed_tool_classes",
    "allowed_provider_ids",
    "maximum_candidates"
  ],
  "properties": {
    "required_capabilities": {"$ref": "#/$defs/requiredCapabilities"},
    "agent": {"$ref": "#/$defs/nullableIdentifier"},
    "workflow": {"$ref": "#/$defs/nullableIdentifier"},
    "execution_mode": {
      "anyOf": [
        {"type": "null"},
        {"enum": ["READ_ONLY", "CONTROLLED_WRITE"]}
      ]
    },
    "max_risk_level": {"enum": ["low", "medium", "high", "approval_required"]},
    "allowed_authority_classes": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": ["READ_ONLY", "CONTROLLED_WRITE", "EXTERNAL_ACTION", "GIT", "DEPLOYMENT"]
          }
        }
      ]
    },
    "allowed_tool_classes": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["local", "connector", "mcp", "provider_native"]}
        }
      ]
    },
    "allowed_provider_ids": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/nonEmptyIdentifiers"}
      ]
    },
    "maximum_candidates": {"type": "integer", "minimum": 1, "maximum": 50}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]{0,199}"
    },
    "nullableIdentifier": {
      "anyOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "nonEmptyIdentifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    }
  }
}
