{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/mutation.schema.json",
  "title": "Agent Company Mutation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "job_id",
    "execution_mode",
    "dry_run",
    "authorization_required",
    "authorized_project_root",
    "allowed_paths",
    "provider_eligibility",
    "scope_fingerprint",
    "created_files",
    "modified_files",
    "deleted_files",
    "changed_files",
    "proposed_created_files",
    "proposed_modified_files",
    "proposed_deleted_files",
    "proposed_changed_files",
    "applied_changed_files",
    "mutation_kind",
    "scope_violations",
    "pre_fingerprints",
    "post_fingerprints",
    "target_post_fingerprints",
    "apply_status",
    "target_integrity",
    "validation",
    "diff_ref"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "execution_mode": {"const": "CONTROLLED_WRITE"},
    "dry_run": {"type": "boolean"},
    "authorization_required": {"const": true},
    "authorized_project_root": {"type": ["string", "null"]},
    "allowed_paths": {"$ref": "#/$defs/path_list"},
    "provider_eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_provider", "executing_provider", "status"],
      "properties": {
        "requested_provider": {"type": ["string", "null"]},
        "executing_provider": {"type": ["string", "null"]},
        "status": {"enum": ["not_executed", "selected_by_canonical_router"]}
      }
    },
    "scope_fingerprint": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "created_files": {"$ref": "#/$defs/path_list"},
    "modified_files": {"$ref": "#/$defs/path_list"},
    "deleted_files": {"$ref": "#/$defs/path_list"},
    "changed_files": {"$ref": "#/$defs/path_list"},
    "proposed_created_files": {"$ref": "#/$defs/path_list"},
    "proposed_modified_files": {"$ref": "#/$defs/path_list"},
    "proposed_deleted_files": {"$ref": "#/$defs/path_list"},
    "proposed_changed_files": {"$ref": "#/$defs/path_list"},
    "applied_changed_files": {"$ref": "#/$defs/path_list"},
    "mutation_kind": {"enum": ["none", "proposed", "applied"]},
    "scope_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "path": {"type": ["string", "null"]},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "pre_fingerprints": {"type": "object"},
    "post_fingerprints": {"type": "object"},
    "target_post_fingerprints": {"type": "object"},
    "apply_status": {
      "type": "string",
      "enum": ["applied", "preview", "not_applied", "rolled_back"]
    },
    "target_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "unchanged"],
      "properties": {
        "before": {"oneOf": [{"$ref": "#/$defs/integrity"}, {"type": "null"}]},
        "after": {"oneOf": [{"$ref": "#/$defs/integrity"}, {"type": "null"}]},
        "unchanged": {"type": ["boolean", "null"]}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "commands"],
      "properties": {
        "status": {"enum": ["not_configured", "passed", "failed"]},
        "commands": {"type": "array"}
      }
    },
    "diff_ref": {
      "oneOf": [
        {"$ref": "job.schema.json#/$defs/ref"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "file_count", "directory_count", "link_count", "total_bytes"],
      "properties": {
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "file_count": {"type": "integer", "minimum": 0},
        "directory_count": {"type": "integer", "minimum": 0},
        "link_count": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "path_list": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
