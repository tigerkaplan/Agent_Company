{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical GOV-02 certification policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "certificates"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "policy_id": {
      "const": "GOV-02-frozen-V1"
    },
    "certificates": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "certificate_id",
          "profiles",
          "status",
          "evidence"
        ],
        "properties": {
          "certificate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 208
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": [
                "READ_ONLY",
                "LOCAL_WRITE",
                "EXTERNAL_PREPARE",
                "EXTERNAL_EXECUTE",
                "SENSITIVE_EXECUTE"
              ]
            }
          },
          "status": {
            "enum": [
              "certified",
              "revoked"
            ]
          },
          "evidence": {
            "const": "governance/capability-governance/README.md"
          }
        }
      }
    }
  }
}
