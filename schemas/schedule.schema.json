{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/schedule.schema.json",
  "title": "Agent Company Canonical Schedule",
  "description": "Versioned schema for deterministic local schedule definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schedule_id",
    "name",
    "created_at",
    "last_updated_at",
    "enabled",
    "schedule_type",
    "task",
    "recurrence",
    "next_run_at",
    "created_by",
    "input_refs"
  ],
  "allOf": [
    {
      "if": {
        "required": ["schedule_type"],
        "properties": {
          "schedule_type": {"const": "one_time"}
        }
      },
      "then": {
        "properties": {
          "recurrence": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "required": ["schedule_type"],
        "properties": {
          "schedule_type": {"const": "recurring"}
        }
      },
      "then": {
        "properties": {
          "recurrence": {
            "type": "string",
            "enum": ["hourly", "daily", "weekly"]
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "schedule_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "last_updated_at": {"type": "string", "format": "date-time"},
    "enabled": {"type": "boolean"},
    "schedule_type": {
      "type": "string",
      "enum": ["one_time", "recurring"]
    },
    "task": {"type": "string", "minLength": 1},
    "task_class": {
      "type": "string",
      "enum": [
        "project-continuation",
        "project-audit",
        "software",
        "research",
        "knowledge",
        "communications",
        "sales",
        "marketing",
        "operations",
        "coordination",
        "review"
      ]
    },
    "project_id": {"type": "string", "minLength": 1},
    "recurrence": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "enum": ["hourly", "daily", "weekly"]}
      ]
    },
    "next_run_at": {"type": "string", "format": "date-time"},
    "last_run_at": {"type": "string", "format": "date-time"},
    "last_occurrence_key": {"type": "string", "minLength": 1},
    "created_by": {"type": "string", "minLength": 1},
    "input_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/ref"}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "last_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "recorded_at"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_type", "ref"],
      "properties": {
        "ref_type": {
          "type": "string",
          "enum": [
            "file",
            "project_state",
            "connector_contract",
            "message",
            "artifact",
            "log",
            "review",
            "approval",
            "provider_result",
            "knowledge_source",
            "other"
          ]
        },
        "ref": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    }
  }
}
