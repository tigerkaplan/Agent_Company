{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/git-push-evidence.schema.json",
  "title": "Agent Company Controlled Git Push Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "push_evidence_id", "push_plan_id", "change_set_id",
    "commit_evidence_ref", "repository_root", "commit_hash", "remote_name",
    "remote_url_display", "remote_url_fingerprint", "remote_branch",
    "remote_head_before", "remote_head_after", "approval_ref", "pushed_at",
    "already_present", "evidence_fingerprint"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "push_evidence_id": {"type": "string", "minLength": 1},
    "push_plan_id": {"type": "string", "minLength": 1},
    "change_set_id": {"type": "string", "minLength": 1},
    "commit_evidence_ref": {"$ref": "job.schema.json#/$defs/ref"},
    "repository_root": {"type": "string", "minLength": 1},
    "commit_hash": {"$ref": "#/$defs/commit"},
    "remote_name": {"type": "string", "minLength": 1},
    "remote_url_display": {"type": "string", "minLength": 1},
    "remote_url_fingerprint": {"$ref": "#/$defs/digest"},
    "remote_branch": {"type": "string", "minLength": 1, "maxLength": 200},
    "remote_head_before": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
    "remote_head_after": {"$ref": "#/$defs/commit"},
    "approval_ref": {"$ref": "job.schema.json#/$defs/ref"},
    "pushed_at": {"type": "string", "format": "date-time"},
    "already_present": {"type": "boolean"},
    "evidence_fingerprint": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
