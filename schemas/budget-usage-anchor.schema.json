{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/budget-usage-anchor.schema.json",
  "title": "Agent Company Execution Budget Usage Anchor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "budget_id",
    "logical_job_id",
    "policy_digest",
    "state_sequence",
    "consumed_execution_units",
    "consumed_elapsed_ms",
    "reservation_count",
    "reservation_history_digest",
    "state_digest",
    "previous_anchor_digest",
    "anchor_digest"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "budget_id": {
      "type": "string",
      "pattern": "^budget-[a-f0-9]{32}$"
    },
    "logical_job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "consumed_execution_units": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "consumed_elapsed_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "reservation_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "reservation_history_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "previous_anchor_digest": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "anchor_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
