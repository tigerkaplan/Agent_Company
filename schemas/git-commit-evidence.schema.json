{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/git-commit-evidence.schema.json",
  "title": "Agent Company Controlled Git Commit Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_id", "change_set_id", "job_id",
    "execution_id", "repository_root", "commit_hash", "parent_hash",
    "committed_files", "commit_message", "author_name", "author_email",
    "committed_at", "approval_ref", "diff_fingerprint",
    "evidence_fingerprint"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "change_set_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "repository_root": {"type": "string", "minLength": 1},
    "commit_hash": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "parent_hash": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "committed_files": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {"type": "string", "minLength": 1}
    },
    "commit_message": {"type": "string", "minLength": 1, "maxLength": 200},
    "author_name": {"type": "string", "minLength": 1},
    "author_email": {"type": "string", "minLength": 1},
    "committed_at": {"type": "string", "format": "date-time"},
    "approval_ref": {"$ref": "job.schema.json#/$defs/ref"},
    "diff_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
