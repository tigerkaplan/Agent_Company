{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/scheduler-state.schema.json",
  "title": "Agent Company Autonomous Scheduler State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scheduler_id", "status", "started_at", "stopped_at",
    "last_cycle_at", "last_updated_at", "worker_id", "active_job_id",
    "cycle_count", "provider_runs_date", "provider_runs_today",
    "stop_requested", "stop_reason", "last_error"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "scheduler_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["stopped", "running", "stopping"]},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "stopped_at": {"type": ["string", "null"], "format": "date-time"},
    "last_cycle_at": {"type": ["string", "null"], "format": "date-time"},
    "last_updated_at": {"type": "string", "format": "date-time"},
    "worker_id": {"type": "string", "minLength": 1},
    "active_job_id": {"type": ["string", "null"]},
    "cycle_count": {"type": "integer", "minimum": 0},
    "provider_runs_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "provider_runs_today": {"type": "integer", "minimum": 0},
    "stop_requested": {"type": "boolean"},
    "stop_reason": {"type": ["string", "null"]},
    "last_error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
