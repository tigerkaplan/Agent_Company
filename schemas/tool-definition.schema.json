{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/tool-definition.schema.json",
  "title": "Canonical Deferred Tool Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_id",
    "version",
    "adapter_id",
    "tool_class",
    "capabilities",
    "authority_class",
    "risk_level",
    "description_context"
  ],
  "properties": {
    "tool_id": {"$ref": "#/$defs/identifier"},
    "version": {"$ref": "#/$defs/identifier"},
    "adapter_id": {"$ref": "#/$defs/identifier"},
    "tool_class": {"enum": ["local", "connector", "mcp", "provider_native"]},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "authority_class": {
      "enum": ["READ_ONLY", "CONTROLLED_WRITE", "EXTERNAL_ACTION", "GIT", "DEPLOYMENT"]
    },
    "risk_level": {"enum": ["low", "medium", "high", "approval_required"]},
    "description_context": {"type": "string", "minLength": 1, "maxLength": 8000}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]{0,199}"
    }
  }
}
