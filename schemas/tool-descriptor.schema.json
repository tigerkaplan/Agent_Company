{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/tool-descriptor.schema.json",
  "title": "Canonical Tool Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_id",
    "name",
    "description",
    "version",
    "capabilities",
    "authority_class",
    "risk_level",
    "tool_class",
    "definition_ref",
    "schema_ref",
    "availability",
    "status",
    "provider_compatibility",
    "agent_compatibility",
    "workflow_compatibility",
    "tags",
    "preference_rank"
  ],
  "properties": {
    "tool_id": {"$ref": "#/$defs/identifier"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "version": {"$ref": "#/$defs/identifier"},
    "capabilities": {"$ref": "#/$defs/nonEmptyIdentifiers"},
    "authority_class": {
      "enum": ["READ_ONLY", "CONTROLLED_WRITE", "EXTERNAL_ACTION", "GIT", "DEPLOYMENT"]
    },
    "risk_level": {"enum": ["low", "medium", "high", "approval_required"]},
    "tool_class": {"enum": ["local", "connector", "mcp", "provider_native"]},
    "definition_ref": {"$ref": "#/$defs/path"},
    "schema_ref": {"$ref": "#/$defs/path"},
    "availability": {"enum": ["available", "unavailable", "disabled"]},
    "status": {"enum": ["active", "deprecated", "disabled"]},
    "provider_compatibility": {"$ref": "#/$defs/identifiers"},
    "agent_compatibility": {"$ref": "#/$defs/identifiers"},
    "workflow_compatibility": {"$ref": "#/$defs/identifiers"},
    "tags": {"$ref": "#/$defs/identifiers"},
    "preference_rank": {"type": "integer", "minimum": 0, "maximum": 1000}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]{0,199}"
    },
    "identifiers": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "nonEmptyIdentifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "(?![~/])(?![\\s\\S]*[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F])(?![\\s\\S]*\\\\)(?![\\s\\S]*:)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))[^/]+(?:/[^/]+)*"
    }
  }
}
